#: common/dialogs/dialog_configure_paths.cpp:324
msgid "Environment variable path cannot be empty."
msgstr "Шлях змінної середовища не може бути порожнім."

#: common/dialogs/dialog_configure_paths.cpp:329
msgid "3D search path alias cannot be empty."
msgstr "Псевдонім шляху пошуку 3D-моделей не може бути порожнім."

