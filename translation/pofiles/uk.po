#: pcbnew/dialogs/panel_setup_rules_help_2constraints.h:2
msgid ""
"### Constraints\n"
"\n"
"| Constraint type           | Argument "
"type                                                                                                         "
"| "
"Description                                                                                                                                                                                                                                                                                                                                                                                                                                             "
"|\n"
"|---------------------------|-----------------------------------------------------------------------------------------------------------------------|---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------|\n"
"| `annular_width`           | min/"
"max                                                                                                               "
"| Checks the width of annular rings on vias."
"<br>                                                                                                                                                                                                                                                                                                                                                                                                          "
"|\n"
"| `assertion`               | \"&lt;"
"expression>\"                                                                                                     "
"| Checks the given expression."
"<br>                                                                                                                                                                                                                                                                                                                                                                                                                        "
"|\n"
"| `bridged_mask`            "
"|                                                                                                                       "
"| Checks for solder mask bridges between copper items.  This constraint does "
"not take a min/opt/max value.  In combination with a severity clause, this "
"constraint can be used to allow or disallow solder mask bridging in various "
"conditions."
"<br>                                                                                                                                                                                                       "
"|\n"
"| `clearance`               | "
"min                                                                                                                   "
"| Specifies the **electrical** clearance between copper objects of different "
"nets.  (See `physical_clearance` if you wish to specify clearance between "
"objects regardless of net.)<br><br>To allow copper objects to overlap "
"(collide), create a `clearance` constraint with the `min` value less than "
"zero (for example, `-1`)."
"<br>                                                                                                                      "
"|\n"
"| `connection_width`        | "
"min                                                                                                                   "
"| Checks the width of connections between pads and zones.  An error will be "
"generated for each pad connection that is narrower than the `min` value."
"<br>                                                                                                                                                                                  "
"|\n"
"| `courtyard_clearance`     | "
"min                                                                                                                   "
"| Checks the clearance between footprint courtyards and generates an error "
"if any two courtyards are closer than the `min` distance.  If a footprint "
"does not have a courtyard shape, no errors will be generated from this "
"constraint."
"<br>                                                                                                                                                                                                               "
"|\n"
"| `creepage`                | "
"min                                                                                                                   "
"| Specifies the creepage distance between copper objects of different nets."
"<br>                                                                                                                                                                                                                                                                                                                                                                           "
"|\n"
"| `diff_pair_gap`           | min/opt/"
"max                                                                                                           "
"| Checks the gap between parallel tracks in a differential pair.  The `opt` "
"setting is used by the interactive router for placing new differential "
"pairs.  An error will be generated if the spacing between tracks in a "
"differential pair is outside of the `min` and `max` settings.  Differential "
"pair gap is not tested on non-parallel portions of a differential pair (for "
"example, the fanout from a component)."
"<br>                                                                                                                                                                                                                                                                       "
"|\n"
"| `diff_pair_uncoupled`     | "
"max                                                                                                                   "
"| Checks the distance that a differential pair track is routed uncoupled "
"from the other polarity track in the pair (for example, where the pair fans "
"out from a component, or becomes uncoupled to pass around another object "
"such as a via)."
"<br>                                                                                                                                                                                                         "
"|\n"
"| `disallow`                | "
"`track`<br>`via`<br>`through_via`<br>`blind_via`<br>`buried_via`<br>`micro_via`<br>`pad`<br>`zone`<br>`text`<br>`graphic`<br>`hole`<br>`footprint`<br> "
"| Specify one or more object types to disallow, separated by spaces.  For "
"example, `(constraint disallow track)` or `(constraint disallow track via "
"pad)`.  If an object of this type matches the rule condition, a DRC error "
"will be created.<br><br>This constraint is essentially the same as a keepout "
"rule area, but can be used to create more specific keepout restrictions."
"<br>                                  |\n"
"| `edge_clearance`          | "
"min                                                                                                                   "
"| Checks the clearance between objects and the board edge.<br><br>This can "
"also be thought of as the \"milling tolerance\" as the board edge will "
"include all graphical items on the `Edge.Cuts` layer as well as any *oval* "
"pad holes.  (See `physical_hole_clearance` for the drilling "
"tolerance.)<br>                                                                                                                                                    "
"|\n"
"| `net_chain_length`        | min/"
"max                                                                                                               "
"| Measures the trunk length between the chain's two terminal pads (set in "
"the schematic) and checks it against `min`/`max`.  Stubs branching off the "
"trunk are bounded separately by `stub_length`, not counted here.  If the "
"chain has no terminal pads or the routed copper contains a loop, the check "
"falls back to the sum of every member net plus series-passive bridging.  "
"When both `length` and `net_chain_length` match the same item, "
"`net_chain_length` wins. |\n"
"| `hole_clearance`          | "
"min                                                                                                                   "
"| Checks the clearance between a drilled hole in a pad or via and copper "
"objects on a different net.  The clearance is measured from the diameter of "
"the hole, not its center."
"<br>                                                                                                                                                                                                                                                                        "
"|\n"
"| `hole_size`               | min/opt/"
"max                                                                                                           "
"| Checks the size (diameter) of a drilled hole in a pad or via.  For oval "
"holes, the smaller (minor) diameter will be tested against the `min` value "
"(if specified) and the larger (major) diameter will be tested against the "
"`max` value (if specified).  The `opt` value is used by the interactive "
"router as the default via hole size for nets that match the rule condition."
"<br>                                                                    |\n"
"| `hole_to_hole`            | "
"min                                                                                                                   "
"| Checks the clearance between mechanically-drilled holes in pads and vias.  "
"The clearance is measured between the diameters of the holes, not between "
"their centers.<br><br>This constraint is soley for the protection of drill "
"bits.  The clearance between **laser-drilled** (microvias) and other non-"
"mechanically-drilled holes is not checked, nor is the clearance between "
"**milled** (oval-shaped) and other non-mechanically-drilled holes.<br> |\n"
"| `length`                  | min/opt/"
"max                                                                                                           "
"| Checks the total routed length for the nets that match the rule condition "
"and generates an error for each net that is below the `min` value (if "
"specified) or above the `max` value (if specified) of the constraint.<br>The "
"`opt` value sets a target length that is used by the length tuning tool for "
"any nets that match the rule condition."
"<br>                                                                                                    "
"|\n"
"| `min_resolved_spokes`     | "
"`0`<br>`1`<br>`2`<br>`3`<br>`4`<br>                                                                                   "
"| Checks the total number of connections (spokes) to a pad.  An error will "
"be raised for each pad that has fewer than the specified number of spokes."
"<br>                                                                                                                                                                                 "
"|\n"
"| `microvia_aspect_ratio`  | "
"max                                                                                                                   "
"| Checks the depth a microvia is drilled against the diameter of its hole. "
"The depth is the dielectric it crosses plus the copper foil the laser enters "
"through. A ratio above the maximum raises an error. IPC-2226 puts the usual "
"limit between 0.75 and 1.0.<br> |\n"
"| `microvia_stack_depth`   | "
"max                                                                                                                   "
"| Checks how many microvias are stacked on one another. A stack deeper than "
"the maximum raises an error. A rule can set a different limit for part of "
"the board, for instance under a fine pitch BGA.<br> |\n"
"| `physical_clearance`      | "
"min                                                                                                                   "
"| Checks the clearance between two objects on a given layer (including non-"
"copper layers).<br><br>While this can perform more general-purpose checks "
"than `clearance`, it is much slower.  Use `clearance` where possible."
"<br>                                                                                                                                                                                                                            "
"|\n"
"| `physical_hole_clearance` | "
"min                                                                                                                   "
"| Checks the clearance between a drilled hole in a pad or via and another "
"object, regardless of net. The clearance is measured from the diameter of "
"the hole, not its center.<br><br>This can also be thought of as the "
"\"drilling tolerance\" as it only includes **round** holes (see "
"`edge_clearance` for the milling tolerance)."
"<br>                                                                                                                    "
"|\n"
"| `silk_clearance`          | "
"min                                                                                                                   "
"| Checks the clearance between objects on silkscreen layers and other "
"objects."
"<br>                                                                                                                                                                                                                                                                                                                                                                        "
"|\n"
"| `stub_length`             | min/"
"max                                                                                                               "
"| Bounds the length of stub member nets on a multi-net chain.  A stub is a "
"member net that does not touch either of the chain's two terminal pads, so "
"it sits off the trunk that runs from one terminal to the other.  Its full "
"routed length is compared against `min`/`max`.<br> |\n"
"| `return_path`             | `(layer \"<layer_name>\")`<br>`(net "
"\"<net_name_or_pattern>\")`                                                            "
"| Requires every track and arc on the chain to be shadowed by a zone on the "
"reference layer.  Each uncovered run produces one marker anchored over the "
"gap.  The optional `(net …)` filter restricts the qualifying zone to a "
"specific net (commonly `\"GND\"`); wildcards are accepted.  Without it, any "
"zone on the reference layer qualifies.  Example: `(constraint return_path "
"(layer \"B.Cu\") (net \"GND\"))`<br> |\n"
"| `skew`                    | min/opt/max/"
"within\\_diff\\_pairs                                                                                       "
"| Checks the total skew for the nets that match the rule condition, that is, "
"the difference between the length of each net and the longest net that is "
"matched by the rule.  If the difference between the longest net and any one "
"net is above the constraint `max` value, an error will be generated.<br>This "
"constraint also sets a target skew that is used by the skew tuning tool for "
"any nets that match the rule condition.  The target skew is the `opt` value, "
"if specified, or the `min` value if not.  If neither `min` nor `opt` are "
"specified, the target skew is `0`.<br>If the option `within_diff_pairs` is "
"specified, the skew will be tested separately for every differential pair in "
"the nets matching the rule.  If `within_diff_pairs` is not specified, the "
"skew will be tested for all matching nets (e.g. for skew tuning a bus)."
"<br>                                                          |\n"
"| `solder_mask_expansion`   | "
"opt                                                                                                                   "
"| Specifies the solder mask expansion for pads, shapes and "
"tracks.                                                                                                                                                                                                                                                                                                                                                                                        "
"|\n"
"| `solder_paste_abs_margin` | "
"opt                                                                                                                   "
"| Specifies the absolute solder paste clearance for pads.  Usually negative "
"to inset the paste.<br><br>The final solder paste clearance will be the "
"absolute clearance plus the relative "
"clearance.                                                                                                                                                                                                                                                        "
"|\n"
"| `solder_paste_rel_margin` | "
"opt                                                                                                                   "
"| Specifies the relative solder paste clearance for pads.  Usually negative "
"to inset the paste.<br><br>The final solder paste clearance will be the "
"absolute clearance plus the relative "
"clearance.                                                                                                                                                                                                                                                        "
"|\n"
"| `text_height`             | min/"
"max                                                                                                               "
"| Checks the height of text, including text boxes.  An error will be "
"generated for each text item that has a height below the `min` value (if "
"specified) or above the `max` value (if specified)."
"<br>                                                                                                                                                                                                                                                     "
"|\n"
"| `text_thickness`          | min/"
"max                                                                                                               "
"| Checks the thickness of text, including text boxes.  An error will be "
"generated for each text item that has a thickness below the `min` value (if "
"specified) or above the `max` value (if specified)."
"<br>                                                                                                                                                                                                                                               "
"|\n"
"| `thermal_relief_gap`      | "
"min                                                                                                                   "
"| Specifies the width of the gap between a pad and a zone with a thermal-"
"relief connection."
"<br>                                                                                                                                                                                                                                                                                                                                                           "
"|\n"
"| `thermal_spoke_width`     | "
"opt                                                                                                                   "
"| Specifies the width of the spokes connecting a pad to a zone with a "
"thermal-relief connection."
"<br>                                                                                                                                                                                                                                                                                                                                                      "
"|\n"
"| `track_angle`             | min/"
"max                                                                                                               "
"| Checks the angle between two connected track segments.  An error will be "
"generated for each connected pair with an angle below the `min` value (if "
"specified) or above the `max` value (if specified)."
"<br>                                                                                                                                                                                                                                              "
"|\n"
"| `track_segment_length`    | min/"
"max                                                                                                               "
"| Checks the length of track and arc segments.  An error will be generated "
"for each segment that has a length below the `min` value (if specified) or "
"above the `max` value (if specified)."
"<br>                                                                                                                                                                                                                                                           "
"|\n"
"| `track_width`             | min/opt/"
"max                                                                                                           "
"| Checks the width of track and arc segments.  An error will be generated "
"for each segment that has a width below the `min` value (if specified) or "
"above the `max` value (if specified).  The `opt` value is used by the "
"interactive router as the default track width for nets that match the rule "
"condition."
"<br>                                                                                                                                       "
"|\n"
"| `via_count`               | min/"
"max                                                                                                               "
"| Counts the number of vias on every net matched by the rule condition.  An "
"error will be generated for each net that has fewer vias than the `min` "
"value (if specified) or more than the `max` value (if specified)."
"<br>                                                                                                                                                                                                                                 "
"|\n"
"| `via_dangling`            "
"|                                                                                                                       "
"| Checks for vias that are unconnected or connected on only one layer.  This "
"constraint does not take a min/opt/max value.  In combination with a "
"severity clause, this constraint can be used to allow or disallow dangling "
"vias in various conditions."
"<br>                                                                                                                                                                                              "
"|\n"
"| `via_diameter`            | min/opt/"
"max                                                                                                           "
"| Checks the diameter of vias.  An error will be generated for each via that "
"has a diameter below the `min` value (if specified) or above the `max` value "
"(if specified).  The `opt` value is used by the interactive router as the "
"default via diameter for nets that match the rule condition."
"<br>                                                                                                                                                      "
"|\n"
"| `zone_connection`         | "
"`solid`<br>`thermal_reliefs`<br>`none`                                                                                "
"| Specifies the connection to be made between a zone and a pad."
"<br>                                                                                                                                                                                                                                                                                                                                                                                       "
"|\n"
"\n"
"\n"
msgstr ""
"### Обмеження\n"
"\n"
"| Тип обмеження             | Тип "
"аргументу                                                                                                         "
"| "
"Опис                                                                                                                                                                                                                                                                                                                                                                                                                                                    "
"|\n"
"|---------------------------|-----------------------------------------------------------------------------------------------------------------------|---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------|\n"
"| `annular_width`           | min/"
"max                                                                                                               "
"| Перевіряє ширину гарантійних поясків перехідних отворів.<br> |\n"
"| `assertion`               | \"&lt;"
"expression>\"                                                                                                     "
"| Перевіряє заданий вираз.<br> |\n"
"| `bridged_mask`            "
"|                                                                                                                       "
"| Перевіряє наявність перемичок паяльної маски між мідними елементами.  Це "
"обмеження не приймає значення min/opt/max.  У поєднанні з пунктом severity "
"його можна використовувати, щоб дозволити або заборонити перемички паяльної "
"маски за різних умов.<br> |\n"
"| `clearance`               | "
"min                                                                                                                   "
"| Задає **електричний** зазор між мідними об'єктами різних зв'язків.  (Див. "
"`physical_clearance`, якщо потрібно задати зазор між об'єктами незалежно від "
"зв'язку.)<br><br>Щоб дозволити мідним об'єктам перекриватися (стикатися), "
"створіть обмеження `clearance` зі значенням `min`, меншим за нуль "
"(наприклад, `-1`).<br> |\n"
"| `connection_width`        | "
"min                                                                                                                   "
"| Перевіряє ширину з'єднань між контактними площадками та зонами.  Для "
"кожного з'єднання контактної площадки, вужчого за значення `min`, буде "
"згенеровано помилку.<br> |\n"
"| `courtyard_clearance`     | "
"min                                                                                                                   "
"| Перевіряє зазор між областями встановлення посадкових місць і генерує "
"помилку, якщо будь-які дві області встановлення розташовані ближче за "
"відстань `min`.  Якщо посадкове місце не має контуру області встановлення, "
"це обмеження не генерує помилок.<br> |\n"
"| `creepage`                | "
"min                                                                                                                   "
"| Задає довжину шляху витоку між мідними об'єктами різних зв'язків.<br> |\n"
"| `diff_pair_gap`           | min/opt/"
"max                                                                                                           "
"| Перевіряє проміжок між паралельними доріжками диференційної пари.  "
"Значення `opt` використовується інтерактивним трасувальником під час "
"прокладання нових диференційних пар.  Якщо відстань між доріжками "
"диференційної пари виходить за межі `min` і `max`, буде згенеровано "
"помилку.  Проміжок диференційної пари не перевіряється на непаралельних "
"ділянках (наприклад, на розведенні від виводів компонента).<br> |\n"
"| `diff_pair_uncoupled`     | "
"max                                                                                                                   "
"| Перевіряє довжину, на якій доріжка диференційної пари прокладена без "
"зв'язку з доріжкою протилежної полярності (наприклад, там, де пара "
"розходиться від компонента або роз'єднується, щоб обійти інший об'єкт, як-от "
"перехідний отвір).<br> |\n"
"| `disallow`                | "
"`track`<br>`via`<br>`through_via`<br>`blind_via`<br>`buried_via`<br>`micro_via`<br>`pad`<br>`zone`<br>`text`<br>`graphic`<br>`hole`<br>`footprint`<br> "
"| Задайте один або кілька типів об'єктів, які забороняються, через пробіл.  "
"Наприклад, `(constraint disallow track)` або `(constraint disallow track via "
"pad)`.  Якщо об'єкт такого типу відповідає умові правила, буде створено "
"помилку DRC.<br><br>По суті це обмеження таке саме, як область правил "
"заборони, але дозволяє задавати конкретніші обмеження.<br> |\n"
"| `edge_clearance`          | "
"min                                                                                                                   "
"| Перевіряє зазор між об'єктами та краєм плати.<br><br>Його також можна "
"вважати «допуском фрезерування», оскільки край плати включає всі графічні "
"елементи на шарі `Edge.Cuts`, а також будь-які *овальні* отвори контактних "
"площадок.  (Допуск свердління див. у `physical_hole_clearance`.)<br> |\n"
"| `net_chain_length`        | min/"
"max                                                                                                               "
"| Вимірює довжину магістралі між двома кінцевими контактними площадками "
"ланцюжка (заданими на схемі) і порівнює її з `min`/`max`.  Відгалуження від "
"магістралі обмежуються окремо через `stub_length` і тут не враховуються.  "
"Якщо ланцюжок не має кінцевих контактних площадок або прокладена мідь "
"містить петлю, перевірка використовує суму довжин усіх зв'язків-учасників "
"плюс перемички через послідовні пасивні компоненти.  Якщо `length` і "
"`net_chain_length` відповідають одному елементу, перевага за "
"`net_chain_length`. |\n"
"| `hole_clearance`          | "
"min                                                                                                                   "
"| Перевіряє зазор між просвердленим отвором контактної площадки чи "
"перехідного отвору та мідними об'єктами іншого зв'язку.  Зазор вимірюється "
"від краю отвору, а не від його центру.<br> |\n"
"| `hole_size`               | min/opt/"
"max                                                                                                           "
"| Перевіряє розмір (діаметр) просвердленого отвору контактної площадки чи "
"перехідного отвору.  Для овальних отворів менший діаметр перевіряється за "
"значенням `min` (якщо задано), а більший — за значенням `max` (якщо "
"задано).  Значення `opt` використовується інтерактивним трасувальником як "
"типовий розмір отвору перехідного отвору для зв'язків, що відповідають умові "
"правила.<br> |\n"
"| `hole_to_hole`            | "
"min                                                                                                                   "
"| Перевіряє зазор між механічно просвердленими отворами контактних площадок "
"і перехідних отворів.  Зазор вимірюється між краями отворів, а не між їхніми "
"центрами.<br><br>Це обмеження призначене виключно для захисту свердел.  "
"Зазор між **лазерними** (мікроперехідними) та іншими немеханічно "
"просвердленими отворами не перевіряється, як і зазор між **фрезерованими** "
"(овальними) та іншими немеханічно просвердленими отворами.<br> |\n"
"| `length`                  | min/opt/"
"max                                                                                                           "
"| Перевіряє загальну прокладену довжину зв'язків, що відповідають умові "
"правила, і генерує помилку для кожного зв'язку, довжина якого менша за "
"значення `min` (якщо задано) або більша за значення `max` (якщо задано)."
"<br>Значення `opt` задає цільову довжину, яку використовує інструмент "
"вирівнювання довжини для зв'язків, що відповідають умові правила.<br> |\n"
"| `min_resolved_spokes`     | "
"`0`<br>`1`<br>`2`<br>`3`<br>`4`<br>                                                                                   "
"| Перевіряє загальну кількість з'єднань (спиць) контактної площадки.  Для "
"кожної контактної площадки, яка має менше спиць, ніж задано, буде "
"згенеровано помилку.<br> |\n"
"| `microvia_aspect_ratio`  | "
"max                                                                                                                   "
"| Перевіряє глибину свердління мікроперехідного отвору відносно діаметра "
"його отвору. Глибина — це діелектрик, який він перетинає, плюс мідна фольга, "
"через яку входить лазер. Співвідношення понад максимум спричиняє помилку. "
"IPC-2226 задає звичайну межу від 0,75 до 1,0.<br> |\n"
"| `microvia_stack_depth`   | "
"max                                                                                                                   "
"| Перевіряє, скільки мікроперехідних отворів розміщено один на одному. Стек "
"глибший за максимум спричиняє помилку. Правило може задавати іншу межу для "
"частини плати, наприклад під BGA з малим кроком.<br> |\n"
"| `physical_clearance`      | "
"min                                                                                                                   "
"| Перевіряє зазор між двома об'єктами на заданому шарі (зокрема на немідних "
"шарах).<br><br>Хоча це обмеження дозволяє загальніші перевірки, ніж "
"`clearance`, воно працює значно повільніше.  За можливості використовуйте "
"`clearance`.<br> |\n"
"| `physical_hole_clearance` | "
"min                                                                                                                   "
"| Перевіряє зазор між просвердленим отвором контактної площадки чи "
"перехідного отвору та іншим об'єктом незалежно від зв'язку. Зазор "
"вимірюється від краю отвору, а не від його центру.<br><br>Його також можна "
"вважати «допуском свердління», оскільки він стосується лише **круглих** "
"отворів (допуск фрезерування див. у `edge_clearance`).<br> |\n"
"| `silk_clearance`          | "
"min                                                                                                                   "
"| Перевіряє зазор між об'єктами на шарах шовкографії та іншими об'єктами."
"<br> |\n"
"| `stub_length`             | min/"
"max                                                                                                               "
"| Обмежує довжину зв'язків-відгалужень у багатозв'язковому ланцюжку.  "
"Відгалуження — це зв'язок-учасник, який не торкається жодної з двох кінцевих "
"контактних площадок ланцюжка, тобто розташований поза магістраллю від одного "
"кінця до іншого.  Його повна прокладена довжина порівнюється з `min`/`max`."
"<br> |\n"
"| `return_path`             | `(layer \"<layer_name>\")`<br>`(net "
"\"<net_name_or_pattern>\")`                                                            "
"| Вимагає, щоб кожна доріжка та дуга ланцюжка були перекриті зоною на "
"опорному шарі.  Кожна неперекрита ділянка створює один маркер над "
"проміжком.  Необов'язковий фільтр `(net …)` обмежує придатну зону конкретним "
"зв'язком (зазвичай `\"GND\"`); допускаються шаблони підстановки.  Без нього "
"підходить будь-яка зона на опорному шарі.  Приклад: `(constraint return_path "
"(layer \"B.Cu\") (net \"GND\"))`<br> |\n"
"| `skew`                    | min/opt/max/"
"within\\_diff\\_pairs                                                                                       "
"| Перевіряє загальний перекіс для зв'язків, що відповідають умові правила, "
"тобто різницю між довжиною кожного зв'язку та найдовшим зв'язком, що "
"відповідає правилу.  Якщо різниця між найдовшим і будь-яким іншим зв'язком "
"перевищує значення `max`, буде згенеровано помилку.<br>Це обмеження також "
"задає цільовий перекіс, який використовує інструмент вирівнювання перекосу "
"для зв'язків, що відповідають умові правила.  Цільовий перекіс — це значення "
"`opt`, якщо його задано, інакше — значення `min`.  Якщо не задано ні `min`, "
"ні `opt`, цільовий перекіс дорівнює `0`.<br>Якщо задано параметр "
"`within_diff_pairs`, перекіс перевіряється окремо для кожної диференційної "
"пари серед зв'язків, що відповідають правилу.  Якщо `within_diff_pairs` не "
"задано, перекіс перевіряється для всіх відповідних зв'язків (наприклад, для "
"вирівнювання перекосу шини).<br> |\n"
"| `solder_mask_expansion`   | "
"opt                                                                                                                   "
"| Задає розширення паяльної маски для контактних площадок, фігур і доріжок. "
"|\n"
"| `solder_paste_abs_margin` | "
"opt                                                                                                                   "
"| Задає абсолютний відступ паяльної пасти для контактних площадок.  Зазвичай "
"від'ємний, щоб зменшити пасту всередину.<br><br>Остаточний відступ паяльної "
"пасти дорівнює сумі абсолютного та відносного відступів. |\n"
"| `solder_paste_rel_margin` | "
"opt                                                                                                                   "
"| Задає відносний відступ паяльної пасти для контактних площадок.  Зазвичай "
"від'ємний, щоб зменшити пасту всередину.<br><br>Остаточний відступ паяльної "
"пасти дорівнює сумі абсолютного та відносного відступів. |\n"
"| `text_height`             | min/"
"max                                                                                                               "
"| Перевіряє висоту тексту, зокрема текстових полів.  Для кожного текстового "
"елемента з висотою, меншою за значення `min` (якщо задано) або більшою за "
"значення `max` (якщо задано), буде згенеровано помилку.<br> |\n"
"| `text_thickness`          | min/"
"max                                                                                                               "
"| Перевіряє товщину тексту, зокрема текстових полів.  Для кожного текстового "
"елемента з товщиною, меншою за значення `min` (якщо задано) або більшою за "
"значення `max` (якщо задано), буде згенеровано помилку.<br> |\n"
"| `thermal_relief_gap`      | "
"min                                                                                                                   "
"| Задає ширину проміжку між контактною площадкою та зоною при з'єднанні "
"через тепловий бар'єр.<br> |\n"
"| `thermal_spoke_width`     | "
"opt                                                                                                                   "
"| Задає ширину спиць, що з'єднують контактну площадку із зоною при з'єднанні "
"через тепловий бар'єр.<br> |\n"
"| `track_angle`             | min/"
"max                                                                                                               "
"| Перевіряє кут між двома з'єднаними сегментами доріжки.  Для кожної "
"з'єднаної пари з кутом, меншим за значення `min` (якщо задано) або більшим "
"за значення `max` (якщо задано), буде згенеровано помилку.<br> |\n"
"| `track_segment_length`    | min/"
"max                                                                                                               "
"| Перевіряє довжину сегментів доріжок і дуг.  Для кожного сегмента з "
"довжиною, меншою за значення `min` (якщо задано) або більшою за значення "
"`max` (якщо задано), буде згенеровано помилку.<br> |\n"
"| `track_width`             | min/opt/"
"max                                                                                                           "
"| Перевіряє ширину сегментів доріжок і дуг.  Для кожного сегмента з шириною, "
"меншою за значення `min` (якщо задано) або більшою за значення `max` (якщо "
"задано), буде згенеровано помилку.  Значення `opt` використовується "
"інтерактивним трасувальником як типова ширина доріжки для зв'язків, що "
"відповідають умові правила.<br> |\n"
"| `via_count`               | min/"
"max                                                                                                               "
"| Підраховує кількість перехідних отворів у кожному зв'язку, що відповідає "
"умові правила.  Для кожного зв'язку, що має менше перехідних отворів, ніж "
"значення `min` (якщо задано), або більше, ніж значення `max` (якщо задано), "
"буде згенеровано помилку.<br> |\n"
"| `via_dangling`            "
"|                                                                                                                       "
"| Перевіряє наявність перехідних отворів, які не під'єднані або під'єднані "
"лише на одному шарі.  Це обмеження не приймає значення min/opt/max.  У "
"поєднанні з пунктом severity його можна використовувати, щоб дозволити або "
"заборонити висячі перехідні отвори за різних умов.<br> |\n"
"| `via_diameter`            | min/opt/"
"max                                                                                                           "
"| Перевіряє діаметр перехідних отворів.  Для кожного перехідного отвору з "
"діаметром, меншим за значення `min` (якщо задано) або більшим за значення "
"`max` (якщо задано), буде згенеровано помилку.  Значення `opt` "
"використовується інтерактивним трасувальником як типовий діаметр перехідного "
"отвору для зв'язків, що відповідають умові правила.<br> |\n"
"| `zone_connection`         | "
"`solid`<br>`thermal_reliefs`<br>`none`                                                                                "
"| Задає тип з'єднання між зоною та контактною площадкою.<br> |\n"
"\n"
"\n"

#: pcbnew/dialogs/panel_setup_rules_help_3items.h:2
msgid ""
"### Items\n"
"\n"
" * `A` &nbsp;&nbsp; _the first (or only) item under test_\n"
" * `B` &nbsp;&nbsp; _the second item under test (for binary tests)_\n"
" * `L` &nbsp;&nbsp; _the layer currently under test_\n"
"\n"
"Conditions for single-item constraints, such as `hole_size`, have no second "
"item.\n"
"Using `B` in these conditions is an error.\n"
"\n"
"<br>\n"
"\n"
msgstr ""
"### Елементи\n"
"\n"
" * `A` &nbsp;&nbsp; _перший (або єдиний) елемент, що перевіряється_\n"
" * `B` &nbsp;&nbsp; _другий елемент, що перевіряється (для бінарних "
"перевірок)_\n"
" * `L` &nbsp;&nbsp; _шар, що наразі перевіряється_\n"
"\n"
"Умови для обмежень з одним елементом, як-от `hole_size`, не мають другого "
"елемента.\n"
"Використання `B` у таких умовах є помилкою.\n"
"\n"
"<br>\n"
"\n"

#: pcbnew/dialogs/panel_setup_rules_help_4severity_names.h:2
msgid ""
"### Severity Names\n"
"\n"
" * warning\n"
" * error\n"
" * exclusion\n"
" * ignore\n"
"\n"
"<br>\n"
"\n"
msgstr ""
"### Назви рівнів серйозності\n"
"\n"
" * warning (попередження)\n"
" * error (помилка)\n"
" * exclusion (виняток)\n"
" * ignore (ігнорувати)\n"
"\n"
"<br>\n"
"\n"

#: pcbnew/dialogs/panel_setup_rules_help_5examples.h:2
msgid ""
"### Examples\n"
"\n"
"    (version 2)\n"
"\n"
"    (rule HV\n"
"       (constraint clearance (min 1.5mm))\n"
"       (condition \"A.hasNetclass('HV')\"))\n"
"\n"
"\n"
"    (rule HV\n"
"       (layer outer)\n"
"       (constraint clearance (min 1.5mm))\n"
"       (condition \"A.hasNetclass('HV')\"))\n"
"\n"
"\n"
"    (rule HV_HV\n"
"       # wider clearance between HV tracks\n"
"       (constraint clearance (min \"1.5mm + 2.0mm\"))\n"
"       (condition \"A.hasNetclass('HV') && B.hasNetclass('HV')\"))\n"
"\n"
"\n"
"    (rule HV_unshielded\n"
"       (constraint clearance (min 2mm))\n"
"       (condition \"A.hasNetclass('HV') && !A.enclosedByArea('Shield*')\"))\n"
"\n"
"\n"
"    (rule heavy_thermals\n"
"       (constraint thermal_spoke_width (min 0.5mm))\n"
"       (condition \"A.hasNetclass('HV')\"))\n"
"\n"
"    # Total routed length across every net in chain SIG_A\n"
"    (rule sig_group_length\n"
"       (constraint net_chain_length (min 40mm) (max 60mm))\n"
"       (condition \"A.Net.NetChain == 'SIG_A'\") )\n"
"\n"
"    # Total propagation delay across every net in chain CLK_GRP\n"
"    (rule sig_group_delay\n"
"       (constraint net_chain_length (min 180ps) (max 220ps) (time_domain "
"yes))\n"
"       (condition \"A.Net.NetChain == 'CLK_GRP'\") )\n"
"\n"
"    # --- Net chain rules: multi-net signals through series passives ---\n"
"\n"
"    # Same effect as sig_group_length, scoped via inNetChain() instead.\n"
"    (rule \"DDR_DQ chain length\"\n"
"       (constraint net_chain_length (min 40mm) (max 60mm))\n"
"       (condition \"A.inNetChain('DDR_DQ*')\") )\n"
"\n"
"    # Stub branches off the trunk of any DDR chain may not exceed 2 mm.\n"
"    (rule \"DDR stub length\"\n"
"       (constraint stub_length (max 2mm))\n"
"       (condition \"A.inNetChain('DDR_*')\") )\n"
"\n"
"    # Every chain in the HighSpeed class needs an unbroken B.Cu return.\n"
"    (rule \"HS return path\"\n"
"       (constraint return_path (layer \"B.Cu\"))\n"
"       (condition \"A.inNetChainClass('HighSpeed')\") )\n"
"\n"
"    # Tighter clearance for any net that belongs to a chain.\n"
"    (rule \"chain members tighter clearance\"\n"
"       (constraint clearance (min 0.2mm))\n"
"       (condition \"A.hasNetChain()\") )\n"
"<br><br>\n"
"\n"
"\n"
msgstr ""
"### Приклади\n"
"\n"
"    (version 2)\n"
"\n"
"    (rule HV\n"
"       (constraint clearance (min 1.5mm))\n"
"       (condition \"A.hasNetclass('HV')\"))\n"
"\n"
"\n"
"    (rule HV\n"
"       (layer outer)\n"
"       (constraint clearance (min 1.5mm))\n"
"       (condition \"A.hasNetclass('HV')\"))\n"
"\n"
"\n"
"    (rule HV_HV\n"
"       # більший зазор між високовольтними доріжками\n"
"       (constraint clearance (min \"1.5mm + 2.0mm\"))\n"
"       (condition \"A.hasNetclass('HV') && B.hasNetclass('HV')\"))\n"
"\n"
"\n"
"    (rule HV_unshielded\n"
"       (constraint clearance (min 2mm))\n"
"       (condition \"A.hasNetclass('HV') && !A.enclosedByArea('Shield*')\"))\n"
"\n"
"\n"
"    (rule heavy_thermals\n"
"       (constraint thermal_spoke_width (min 0.5mm))\n"
"       (condition \"A.hasNetclass('HV')\"))\n"
"\n"
"    # Загальна прокладена довжина всіх зв'язків ланцюжка SIG_A\n"
"    (rule sig_group_length\n"
"       (constraint net_chain_length (min 40mm) (max 60mm))\n"
"       (condition \"A.Net.NetChain == 'SIG_A'\") )\n"
"\n"
"    # Загальна затримка поширення всіх зв'язків ланцюжка CLK_GRP\n"
"    (rule sig_group_delay\n"
"       (constraint net_chain_length (min 180ps) (max 220ps) (time_domain "
"yes))\n"
"       (condition \"A.Net.NetChain == 'CLK_GRP'\") )\n"
"\n"
"    # --- Правила ланцюжків зв'язків: багатозв'язкові сигнали через "
"послідовні пасивні компоненти ---\n"
"\n"
"    # Той самий ефект, що й sig_group_length, але з областю дії через "
"inNetChain().\n"
"    (rule \"DDR_DQ chain length\"\n"
"       (constraint net_chain_length (min 40mm) (max 60mm))\n"
"       (condition \"A.inNetChain('DDR_DQ*')\") )\n"
"\n"
"    # Відгалуження від магістралі будь-якого ланцюжка DDR не можуть "
"перевищувати 2 мм.\n"
"    (rule \"DDR stub length\"\n"
"       (constraint stub_length (max 2mm))\n"
"       (condition \"A.inNetChain('DDR_*')\") )\n"
"\n"
"    # Кожен ланцюжок класу HighSpeed потребує безперервного зворотного шляху "
"на B.Cu.\n"
"    (rule \"HS return path\"\n"
"       (constraint return_path (layer \"B.Cu\"))\n"
"       (condition \"A.inNetChainClass('HighSpeed')\") )\n"
"\n"
"    # Менший зазор для будь-якого зв'язку, що належить ланцюжку.\n"
"    (rule \"chain members tighter clearance\"\n"
"       (constraint clearance (min 0.2mm))\n"
"       (condition \"A.hasNetChain()\") )\n"
"<br><br>\n"
"\n"
"\n"

#: pcbnew/dialogs/panel_setup_rules_help_6notes.h:2
msgid ""
"### Notes\n"
"\n"
"Version clause must be the first clause.  It indicates the syntax version of "
"the file so that\n"
"future rules parsers can perform automatic updates.  It should be\n"
"set to \"1\".\n"
"\n"
"Rules should be ordered by specificity.  Later rules take\n"
"precedence over earlier rules; once a matching rule is found\n"
"no further rules will be checked.\n"
"\n"
"Use Ctrl+/ to comment or uncomment line(s).\n"
"\n"
"### Graphical Rule Editor\n"
"\n"
"When loading rules into the graphical editor, constraints are automatically\n"
"mapped to appropriate editing panels. Rules with multiple constraints may "
"be\n"
"split across panels, each showing a subset of the rule's constraints.\n"
"\n"
"Multi-constraint panels like Via Style (`via_diameter` + `hole_size`) and\n"
"Differential Pair Routing (`track_width` + `diff_pair_gap`) are matched "
"first.\n"
"Single-constraint panels handle the remainder. Unmapped constraints appear\n"
"in the Custom Rule panel.\n"
"\n"
"Rules that are not modified in the graphical editor preserve their original\n"
"text formatting when saved.\n"
"<br><br><br>\n"
"\n"
"`net_chain_length` vs `length`:\n"
"\n"
"When a net belongs to a chain and both constraints match, `net_chain_length` "
"is checked against the trunk (the unique path between the two terminal pads) "
"and `length` is ignored.  Stubs branching off the trunk don't count toward "
"the trunk length; use `stub_length` to bound them.  If the chain has no "
"terminal pads or the routed copper contains a loop, `net_chain_length` falls "
"back to the sum of every member net plus series-passive bridging.  Nets that "
"don't belong to a chain still see `length`.\n"
"\n"
"Time-domain targets:\n"
"\n"
"Both constraints accept `(time_domain yes)` to bound propagation delay "
"instead of physical length.  For `net_chain_length` in time-domain mode the "
"delay window applies to the chain as a whole; the tuner subtracts the routed "
"delay from the other member nets to figure out what's left for the net being "
"tuned.\n"
"\n"
"\n"
"<br><br><br>"
msgstr ""
"### Примітки\n"
"\n"
"Пункт version має бути першим.  Він вказує версію синтаксису файлу, щоб\n"
"майбутні аналізатори правил могли виконувати автоматичне оновлення.  Його "
"слід\n"
"встановити в \"1\".\n"
"\n"
"Правила слід впорядковувати за специфічністю.  Пізніші правила мають\n"
"пріоритет над ранішими; щойно знайдено відповідне правило,\n"
"подальші правила не перевіряються.\n"
"\n"
"Використовуйте Ctrl+/, щоб закоментувати або розкоментувати рядок(и).\n"
"\n"
"### Графічний редактор правил\n"
"\n"
"Під час завантаження правил у графічний редактор обмеження автоматично\n"
"розподіляються між відповідними панелями редагування. Правила з кількома "
"обмеженнями можуть\n"
"бути розділені між панелями, кожна з яких показує частину обмежень правила.\n"
"\n"
"Панелі з кількома обмеженнями, як-от «Стиль перехідного "
"отвору» (`via_diameter` + `hole_size`) і\n"
"«Трасування диференційної пари» (`track_width` + `diff_pair_gap`), "
"зіставляються першими.\n"
"Панелі з одним обмеженням обробляють решту. Нерозподілені обмеження "
"показуються\n"
"на панелі «Власне правило».\n"
"\n"
"Правила, не змінені в графічному редакторі, під час збереження зберігають\n"
"початкове форматування тексту.\n"
"<br><br><br>\n"
"\n"
"`net_chain_length` і `length`:\n"
"\n"
"Якщо зв'язок належить ланцюжку і обидва обмеження йому відповідають, "
"`net_chain_length` перевіряється для магістралі (єдиного шляху між двома "
"кінцевими контактними площадками), а `length` ігнорується.  Відгалуження від "
"магістралі не враховуються в її довжині; для їх обмеження використовуйте "
"`stub_length`.  Якщо ланцюжок не має кінцевих контактних площадок або "
"прокладена мідь містить петлю, `net_chain_length` використовує суму довжин "
"усіх зв'язків-учасників плюс перемички через послідовні пасивні компоненти.  "
"Для зв'язків, що не належать ланцюжку, діє `length`.\n"
"\n"
"Цілі в часовій області:\n"
"\n"
"Обидва обмеження приймають `(time_domain yes)`, щоб обмежувати затримку "
"поширення замість фізичної довжини.  Для `net_chain_length` у режимі часової "
"області вікно затримки застосовується до ланцюжка загалом; інструмент "
"вирівнювання віднімає прокладену затримку інших зв'язків-учасників, щоб "
"визначити залишок для зв'язку, що вирівнюється.\n"
"\n"
"\n"
"<br><br><br>"

#: pcbnew/dialogs/panel_setup_rules_help_7properties.h:2
msgid ""
"### Properties\n"
"\n"
"Many properties of objects are available for testing in custom rule "
"expressions. See the full documentation at [https://docs.kicad.org](https://"
"go.kicad.org/docs/GetMajorMinorVersion/en/pcbnew/pcbnew."
"html#custom_design_rules) for the complete list.\n"
"<br><br><br>\n"
"\n"
msgstr ""
"### Властивості\n"
"\n"
"У виразах користувацьких правил можна перевіряти багато властивостей "
"об'єктів. Повний список наведено в документації за адресою [https://docs."
"kicad.org](https://go.kicad.org/docs/GetMajorMinorVersion/en/pcbnew/pcbnew."
"html#custom_design_rules).\n"
"<br><br><br>\n"
"\n"

#: pcbnew/dialogs/panel_setup_rules_help_8expression_functions.h:2
msgid ""
"### Expression functions\n"
"\n"
"All function parameters support simple wildcards (`*` and `?`).\n"
"\n"
"Arguments can also be expressions. For example,\n"
"`A.intersectsFrontCourtyard(B.Parent)` tests whether `A` intersects the "
"front\n"
"courtyard of `B`'s parent footprint.\n"
"\n"
"\n"
"```\n"
"    A.enclosedByArea('<zone_name>')\n"
"```\n"
"> True if all of `A` lies within the given zone's outline.\n"
"\n"
"> NB: this is potentially a more expensive call than `intersectsArea()`.\n"
"Use `intersectsArea()` where possible.\n"
"\n"
"\n"
"```\n"
"    A.existsOnLayer('<layer_name>')\n"
"```\n"
"> True if `A` exists on the given layer.  The layer name can be\n"
"either the name assigned in Board Setup > Board Editor Layers or\n"
"the canonical name (ie: `F.Cu`).\n"
"\n"
"> NB: this returns true if `A` is on the given layer, independently\n"
"of whether or not the rule is being evaluated for that layer.\n"
"For the latter use a `(layer \"layer_name\")` clause in the rule.\n"
"\n"
"\n"
"```\n"
"    A.fromTo('x', 'y')\n"
"```\n"
"> True if the object exists on the copper path between the given\n"
"pads. `x` and `y` are the full names of pads in the design, such as\n"
"`R1-Pad1`.\n"
"\n"
"\n"
"```\n"
"    A.getField('<field_name>')\n"
"```\n"
"> The value of the given field. Only footprints have fields, so a field is "
"only returned if\n"
"`A` is a footprint.\n"
"\n"
"\n"
"```\n"
"    A.hasComponentClass('<component_class_name>')\n"
"```\n"
"> True if the set of component classes assigned to `A` contains the named\n"
"component class.\n"
"\n"
"\n"
"```\n"
"    A.hasNetclass('<netclass_name>')\n"
"```\n"
"> True if `A` has had the given netclass assigned to it, either by an "
"explicit netclass label\n"
"or through a pattern match assignment.\n"
"\n"
"\n"
"```\n"
"    A.inDiffPair('<net_name>')\n"
"```\n"
"> True if `A` has a net that is part of the specified differential pair.\n"
"`<net_name>` is the base name of the differential pair.\n"
"For example, `inDiffPair('/CLK')` matches items in the `/CLK_P` and `/CLK_N` "
"nets.\n"
"\n"
"\n"
"\n"
"```\n"
"    A.inNetChain('<chain_name>')\n"
"```\n"
"> True if `A`'s net is a member of the named chain.  `<chain_name>`\n"
"accepts wildcards: `inNetChain('DDR_*')` matches every chain whose\n"
"name starts with `DDR_`.\n"
"\n"
"\n"
"\n"
"```\n"
"    A.hasNetChain()\n"
"```\n"
"> True if `A`'s net belongs to any chain.\n"
"\n"
"\n"
"\n"
"```\n"
"    A.inNetChainClass('<class_name>')\n"
"```\n"
"> True if `A`'s net belongs to a chain whose assigned chain class\n"
"matches `<class_name>`.  Class assignments live in the project's\n"
"`net_chain_classes` map.  `<class_name>` accepts wildcards.\n"
"\n"
"\n"
"\n"
"```\n"
"    A.intersectsArea('<zone_name>')\n"
"```\n"
"> True if any part of `A` lies within the given zone's outline.\n"
"\n"
"\n"
"```\n"
"    A.intersectsCourtyard('<footprint_identifier>')\n"
"```\n"
"> True if any part of `A` lies within the given footprint's principal "
"courtyard.\n"
"\n"
"\n"
"```\n"
"    A.intersectsFrontCourtyard('<footprint_identifier>')\n"
"```\n"
"> True if any part of `A` lies within the given footprint's front "
"courtyard.\n"
"\n"
"\n"
"```\n"
"    A.intersectsBackCourtyard('<footprint_identifier>')\n"
"```\n"
"> True if any part of `A` lies within the given footprint's back courtyard.\n"
"\n"
"\n"
"> The `footprint_identifier` listed above can be one of the following:\n"
"\n"
"> 1. A reference designator, possibly containing wildcards `*` and `?`\n"
"> 2. A footprint library identifier such as `LibName:FootprintName`. In this "
"case,\n"
"   the library identifier must contain the `:` character to separate the "
"library\n"
"   name from the footprint name, and either name may contain wildcards.\n"
"> 3. A component class, in the form `${Class:ClassName}`.  The keyword "
"`Class` is not\n"
"   case-sensitive, but component class names are case-sensitive.\n"
"\n"
"\n"
"```\n"
"    AB.isCoupledDiffPair()\n"
"```\n"
"> True if `A` and `B` are members of the same diff pair.\n"
"\n"
"\n"
"```\n"
"    A.isMicroVia()\n"
"```\n"
"> True if `A` is a microvia.\n"
"\n"
"\n"
"```\n"
"    A.isBlindVia()\n"
"```\n"
"> True if `A` is a blind via.\n"
"\n"
"\n"
"```\n"
"    A.isBuriedVia()\n"
"```\n"
"> True if `A` is a buried via.\n"
"\n"
"\n"
"```\n"
"    A.isStackedVia()\n"
"```\n"
"> True if `A` is a microvia that lands on another microvia, or is landed on "
"by one.\n"
"\n"
"> The test is hole overlap, so a staggered pair counts whenever the holes "
"touch.\n"
"\n"
"\n"
"```\n"
"    A.isPlated()\n"
"```\n"
"> True if `A` has a hole which is plated.\n"
"\n"
"\n"
"```\n"
"    A.memberOfGroup('<group_name>')\n"
"```\n"
"> True if `A` is a member of the given group\n"
"The name can contain wildcards.\n"
"Includes nested membership.\n"
"\n"
"\n"
"```\n"
"    A.memberOfFootprint('<footprint_identifier>')\n"
"```\n"
"> True if `A` is a member of a given footprint\n"
"(for example, a pad or graphic shape defined inside that footprint).\n"
"The various ways of specifying `footprint_identifier` are described above.\n"
"\n"
"\n"
"```\n"
"    A.memberOfSheet('<sheet_path>')\n"
"```\n"
"> True if `A` is a member of the given schematic sheet.\n"
"The sheet path can contain wildcards.\n"
"\n"
"\n"
"```\n"
"    A.memberOfSheetOrChildren('<sheet_path>')\n"
"```\n"
"> True if `A` is a member of the given schematic sheet, or any of its child "
"hierarchical sheets.\n"
"The sheet path can contain wildcards.\n"
"\n"
"\n"
msgstr ""
"### Функції виразів\n"
"\n"
"Усі параметри функцій підтримують прості шаблони підстановки (`*` і `?`).\n"
"\n"
"Аргументи також можуть бути виразами. Наприклад,\n"
"`A.intersectsFrontCourtyard(B.Parent)` перевіряє, чи перетинає `A` верхню\n"
"область встановлення батьківського посадкового місця `B`.\n"
"\n"
"\n"
"```\n"
"    A.enclosedByArea('<zone_name>')\n"
"```\n"
"> True, якщо весь `A` лежить у межах контуру заданої зони.\n"
"\n"
"> Примітка: цей виклик потенційно затратніший, ніж `intersectsArea()`.\n"
"За можливості використовуйте `intersectsArea()`.\n"
"\n"
"\n"
"```\n"
"    A.existsOnLayer('<layer_name>')\n"
"```\n"
"> True, якщо `A` існує на заданому шарі.  Назвою шару може бути\n"
"або назва, призначена в Налаштування плати > Шари редактора плати, або\n"
"канонічна назва (напр.: `F.Cu`).\n"
"\n"
"> Примітка: повертає true, якщо `A` лежить на заданому шарі, незалежно\n"
"від того, чи обчислюється правило для цього шару.\n"
"Для останнього використовуйте в правилі пункт `(layer \"layer_name\")`.\n"
"\n"
"\n"
"```\n"
"    A.fromTo('x', 'y')\n"
"```\n"
"> True, якщо об'єкт лежить на мідному шляху між заданими\n"
"контактними площадками. `x` і `y` — повні імена площадок у проєкті, "
"наприклад\n"
"`R1-Pad1`.\n"
"\n"
"\n"
"```\n"
"    A.getField('<field_name>')\n"
"```\n"
"> Значення заданого поля. Поля мають лише посадкові місця, тож поле "
"повертається лише тоді,\n"
"коли `A` — посадкове місце.\n"
"\n"
"\n"
"```\n"
"    A.hasComponentClass('<component_class_name>')\n"
"```\n"
"> True, якщо набір класів компонентів, призначених `A`, містить названий\n"
"клас компонентів.\n"
"\n"
"\n"
"```\n"
"    A.hasNetclass('<netclass_name>')\n"
"```\n"
"> True, якщо `A` призначено заданий клас зв'язків — явною міткою класу "
"зв'язків\n"
"або через призначення за шаблоном.\n"
"\n"
"\n"
"```\n"
"    A.inDiffPair('<net_name>')\n"
"```\n"
"> True, якщо `A` має зв'язок, що входить до заданої диференційної пари.\n"
"`<net_name>` — базова назва диференційної пари.\n"
"Наприклад, `inDiffPair('/CLK')` відповідає елементам у зв'язках `/CLK_P` і `/"
"CLK_N`.\n"
"\n"
"\n"
"\n"
"```\n"
"    A.inNetChain('<chain_name>')\n"
"```\n"
"> True, якщо зв'язок `A` входить до названого ланцюжка.  `<chain_name>`\n"
"приймає шаблони підстановки: `inNetChain('DDR_*')` відповідає кожному "
"ланцюжку,\n"
"назва якого починається з `DDR_`.\n"
"\n"
"\n"
"\n"
"```\n"
"    A.hasNetChain()\n"
"```\n"
"> True, якщо зв'язок `A` належить будь-якому ланцюжку.\n"
"\n"
"\n"
"\n"
"```\n"
"    A.inNetChainClass('<class_name>')\n"
"```\n"
"> True, якщо зв'язок `A` належить ланцюжку, призначений клас якого\n"
"відповідає `<class_name>`.  Призначення класів зберігаються в мапі\n"
"`net_chain_classes` проєкту.  `<class_name>` приймає шаблони підстановки.\n"
"\n"
"\n"
"\n"
"```\n"
"    A.intersectsArea('<zone_name>')\n"
"```\n"
"> True, якщо будь-яка частина `A` лежить у межах контуру заданої зони.\n"
"\n"
"\n"
"```\n"
"    A.intersectsCourtyard('<footprint_identifier>')\n"
"```\n"
"> True, якщо будь-яка частина `A` лежить у межах основної області "
"встановлення заданого посадкового місця.\n"
"\n"
"\n"
"```\n"
"    A.intersectsFrontCourtyard('<footprint_identifier>')\n"
"```\n"
"> True, якщо будь-яка частина `A` лежить у межах верхньої області "
"встановлення заданого посадкового місця.\n"
"\n"
"\n"
"```\n"
"    A.intersectsBackCourtyard('<footprint_identifier>')\n"
"```\n"
"> True, якщо будь-яка частина `A` лежить у межах нижньої області "
"встановлення заданого посадкового місця.\n"
"\n"
"\n"
"> Наведений вище `footprint_identifier` може бути одним із такого:\n"
"\n"
"> 1. Позиційне позначення, можливо з шаблонами підстановки `*` і `?`\n"
"> 2. Бібліотечний ідентифікатор посадкового місця, напр. `LibName:"
"FootprintName`. У цьому разі\n"
"   ідентифікатор має містити символ `:`, що відокремлює назву бібліотеки\n"
"   від назви посадкового місця; обидві назви можуть містити шаблони "
"підстановки.\n"
"> 3. Клас компонентів у формі `${Class:ClassName}`.  Ключове слово `Class` "
"не\n"
"   чутливе до регістру, але назви класів компонентів чутливі до регістру.\n"
"\n"
"\n"
"```\n"
"    AB.isCoupledDiffPair()\n"
"```\n"
"> True, якщо `A` і `B` входять до однієї диференційної пари.\n"
"\n"
"\n"
"```\n"
"    A.isMicroVia()\n"
"```\n"
"> True, якщо `A` — мікроперехідний отвір.\n"
"\n"
"\n"
"```\n"
"    A.isBlindVia()\n"
"```\n"
"> True, якщо `A` — глухий перехідний отвір.\n"
"\n"
"\n"
"```\n"
"    A.isBuriedVia()\n"
"```\n"
"> True, якщо `A` — прихований перехідний отвір.\n"
"\n"
"\n"
"```\n"
"    A.isStackedVia()\n"
"```\n"
"> True, якщо `A` — мікроперехідний отвір, що спирається на інший "
"мікроперехідний отвір або на який спирається інший.\n"
"\n"
"> Перевіряється перекриття отворів, тож зміщена пара враховується, щойно "
"отвори торкаються.\n"
"\n"
"\n"
"```\n"
"    A.isPlated()\n"
"```\n"
"> True, якщо `A` має металізований отвір.\n"
"\n"
"\n"
"```\n"
"    A.memberOfGroup('<group_name>')\n"
"```\n"
"> True, якщо `A` входить до заданої групи.\n"
"Назва може містити шаблони підстановки.\n"
"Враховується вкладене членство.\n"
"\n"
"\n"
"```\n"
"    A.memberOfFootprint('<footprint_identifier>')\n"
"```\n"
"> True, якщо `A` належить заданому посадковому місцю\n"
"(наприклад, контактна площадка чи графічна фігура, визначена в ньому).\n"
"Способи задання `footprint_identifier` описано вище.\n"
"\n"
"\n"
"```\n"
"    A.memberOfSheet('<sheet_path>')\n"
"```\n"
"> True, якщо `A` належить заданому аркушу схеми.\n"
"Шлях аркуша може містити шаблони підстановки.\n"
"\n"
"\n"
"```\n"
"    A.memberOfSheetOrChildren('<sheet_path>')\n"
"```\n"
"> True, якщо `A` належить заданому аркушу схеми або будь-якому з його "
"дочірніх ієрархічних аркушів.\n"
"Шлях аркуша може містити шаблони підстановки.\n"
"\n"
"\n"

#: pcbnew/dialogs/panel_setup_rules_help_9more_examples.h:2
msgid ""
"### More Examples\n"
"\n"
"    (rule \"copper keepout\"\n"
"       (constraint disallow track via zone)\n"
"       (condition \"A.intersectsArea('zone3')\"))\n"
"\n"
"\n"
"    (rule \"BGA neckdown\"\n"
"       (constraint track_width (min 0.2mm) (opt 0.25mm))\n"
"       (constraint clearance (min 0.05mm) (opt 0.08mm))\n"
"       (condition \"A.intersectsCourtyard('U3')\"))\n"
"\n"
"\n"
"    # prevent silk over tented vias\n"
"    (rule silk_over_via\n"
"       (constraint silk_clearance (min 0.2mm))\n"
"       (condition \"A.Type == '*Text' && B.Type == 'Via'\"))\n"
"\n"
"\n"
"    (rule \"Distance between Vias of Different Nets\"\n"
"        (constraint hole_to_hole (min 0.254mm))\n"
"        (condition \"A.Type == 'Via' && B.Type == 'Via' && A.Net != B."
"Net\"))\n"
"\n"
"    (rule \"Clearance between Pads of Different Nets\"\n"
"        (constraint clearance (min 3.0mm))\n"
"        (condition \"A.Type == 'Pad' && B.Type == 'Pad' && A.Net != B."
"Net\"))\n"
"\n"
"\n"
"    (rule \"Via Hole to Track Clearance\"\n"
"        (constraint hole_clearance (min 0.254mm))\n"
"        (condition \"A.Type == 'Via' && B.Type == 'Track'\"))\n"
"\n"
"    (rule \"Pad to Track Clearance\"\n"
"        (constraint clearance (min 0.2mm))\n"
"        (condition \"A.Type == 'Pad' && B.Type == 'Track'\"))\n"
"\n"
"\n"
"    (rule \"clearance-to-1mm-cutout\"\n"
"        (constraint edge_clearance (min 0.8mm))\n"
"        (condition \"A.Layer == 'Edge.Cuts' && A.Line_Width == 1.0mm\"))\n"
"\n"
"\n"
"    (rule \"Max Drill Hole Size Mechanical\"\n"
"        (constraint hole_size (max 6.3mm))\n"
"        (condition \"A.Pad_Type == 'NPTH, mechanical'\"))\n"
"\n"
"    (rule \"Max Drill Hole Size PTH\"\n"
"        (constraint hole_size (max 6.35mm))\n"
"        (condition \"A.Pad_Type == 'Through-hole'\"))\n"
"\n"
"\n"
"    # Specify an optimal gap for a particular diff-pair\n"
"    (rule \"dp clock gap\"\n"
"        (constraint diff_pair_gap (opt \"0.8mm\"))\n"
"        (condition \"A.inDiffPair('/CLK')\"))\n"
"\n"
"    # Specify a larger clearance around any diff-pair\n"
"    (rule \"dp clearance\"\n"
"        (constraint clearance (min \"1.5mm\"))\n"
"        (condition \"A.inDiffPair('*') && !AB.isCoupledDiffPair()\"))\n"
"\n"
"\n"
"    # Don't use thermal reliefs on heatsink pads\n"
"    (rule heat_sink_pad\n"
"        (constraint zone_connection solid)\n"
"        (condition \"A.Fabrication_Property == 'Heatsink pad'\"))\n"
"\n"
"    # Require all four thermal relief spokes to connect to parent zone\n"
"    (rule fully_spoked_pads\n"
"        (constraint min_resolved_spokes 4))\n"
"\n"
"    # Set thermal relief gap & spoke width for all zones\n"
"    (rule defined_relief\n"
"        (constraint thermal_relief_gap (min 10mil))\n"
"        (constraint thermal_spoke_width (min 12mil)))\n"
"\n"
"    # Override thermal relief gap & spoke width for GND and PWR zones\n"
"    (rule defined_relief_pwr\n"
"        (constraint thermal_relief_gap (min 10mil))\n"
"        (constraint thermal_spoke_width (min 12mil))\n"
"        (condition \"A.Name == 'zone_GND' || A.Name == 'zone_PWR'\"))\n"
"\n"
"    # Prevent copper fills under the courtyards of capacitors\n"
"    (rule no_copper_under_caps\n"
"        (constraint physical_clearance (min 0mm))\n"
"        (condition \"A.Type == 'Zone' && B.Reference == 'C*'\"))\n"
"\n"
"\n"
"    # Prevent solder wicking from SMD pads\n"
"    (rule holes_in_pads\n"
"        (constraint physical_hole_clearance (min 0.2mm))\n"
"        (condition \"B.Pad_Type == 'SMD'\"))\n"
"\n"
"    # Disallow solder mask margin overrides\n"
"    (rule \"disallow solder mask margin overrides\"\n"
"        (constraint assertion \"A.Soldermask_Margin_Override == null\")\n"
"        (condition \"A.Type == 'Pad'\"))\n"
"\n"
"\n"
"    # Enforce a mechanical clearance between components and board edge\n"
"    (rule front_mechanical_board_edge_clearance\n"
"        (layer \"F.Courtyard\")\n"
"        (constraint physical_clearance (min 3mm))\n"
"        (condition \"B.Layer == 'Edge.Cuts'\"))\n"
"\n"
"\n"
"    # Allow silk intersection with board edge for connectors\n"
"    (rule silk_board_edge_clearance\n"
"        (constraint silk_clearance)\n"
"        (severity ignore)\n"
"        (condition \"A.memberOfFootprint('J*') && B.Layer=='Edge.Cuts'\"))\n"
"\n"
"\n"
"    # Check current-carrying capacity\n"
"    (rule high-current\n"
"        (constraint track_width (min 1.0mm))\n"
"        (constraint connection_width (min 0.8mm))\n"
"        (condition \"A.hasNetclass('Power')\"))\n"
"\n"
"\n"
"    # Separate drill bit and milling cutter size constraints\n"
"    (rule \"Plated through-hole size\"\n"
"        (constraint hole_size (min 0.2mm) (max 6.35mm))\n"
"        (condition \"A.isPlated() && A.Hole_Size_X == A.Hole_Size_Y\"))\n"
"    (rule \"Plated slot size\"\n"
"        (constraint hole_size (min 0.5mm))\n"
"        (condition \"A.isPlated() && A.Hole_Size_X != A.Hole_Size_Y\"))\n"
"\n"
"\n"
"    # Allow blind to micro-via hole-to-hole violations when it is known "
"that\n"
"    # the fab will mechanically drill blind via holes -before- laser "
"drilling\n"
"    # micro-vias.\n"
"    (rule hole_to_hole_uvia_exclusion\n"
"        (condition \"A.Via_Type == 'Blind' && B.Via_Type == 'Micro'\")\n"
"        (constraint hole_to_hole)\n"
"        (severity ignore))\n"
"\n"
"\n"
"    # No solder mask expansion for vias.\n"
"    (rule \"no mask expansion on vias\"\n"
"        (constraint solder_mask_expansion (opt 0mm))\n"
"        (condition \"A.type == via\"))\n"
"\n"
"\n"
"    # Remove solder paste from DNP footprints.\n"
"    (rule remove_solder_paste_from_DNP\n"
"        (constraint solder_paste_abs_margin (opt -50mm))\n"
"        (condition \"A.Do_not_Populate\"))\n"
"\n"
"\n"
"    # Allow solder mask bridging under guard ring mask apertures\n"
"    (rule guard_ring_bridging\n"
"        (constraint bridged_mask)\n"
"        (condition \"A.intersectsArea('guard_ring')\")\n"
"        (severity ignore))\n"
msgstr ""
"### Інші приклади\n"
"\n"
"    (rule \"copper keepout\"\n"
"       (constraint disallow track via zone)\n"
"       (condition \"A.intersectsArea('zone3')\"))\n"
"\n"
"\n"
"    (rule \"BGA neckdown\"\n"
"       (constraint track_width (min 0.2mm) (opt 0.25mm))\n"
"       (constraint clearance (min 0.05mm) (opt 0.08mm))\n"
"       (condition \"A.intersectsCourtyard('U3')\"))\n"
"\n"
"\n"
"    # заборонити шовкографію над закритими маскою перехідними отворами\n"
"    (rule silk_over_via\n"
"       (constraint silk_clearance (min 0.2mm))\n"
"       (condition \"A.Type == '*Text' && B.Type == 'Via'\"))\n"
"\n"
"\n"
"    (rule \"Distance between Vias of Different Nets\"\n"
"        (constraint hole_to_hole (min 0.254mm))\n"
"        (condition \"A.Type == 'Via' && B.Type == 'Via' && A.Net != B."
"Net\"))\n"
"\n"
"    (rule \"Clearance between Pads of Different Nets\"\n"
"        (constraint clearance (min 3.0mm))\n"
"        (condition \"A.Type == 'Pad' && B.Type == 'Pad' && A.Net != B."
"Net\"))\n"
"\n"
"\n"
"    (rule \"Via Hole to Track Clearance\"\n"
"        (constraint hole_clearance (min 0.254mm))\n"
"        (condition \"A.Type == 'Via' && B.Type == 'Track'\"))\n"
"\n"
"    (rule \"Pad to Track Clearance\"\n"
"        (constraint clearance (min 0.2mm))\n"
"        (condition \"A.Type == 'Pad' && B.Type == 'Track'\"))\n"
"\n"
"\n"
"    (rule \"clearance-to-1mm-cutout\"\n"
"        (constraint edge_clearance (min 0.8mm))\n"
"        (condition \"A.Layer == 'Edge.Cuts' && A.Line_Width == 1.0mm\"))\n"
"\n"
"\n"
"    (rule \"Max Drill Hole Size Mechanical\"\n"
"        (constraint hole_size (max 6.3mm))\n"
"        (condition \"A.Pad_Type == 'NPTH, mechanical'\"))\n"
"\n"
"    (rule \"Max Drill Hole Size PTH\"\n"
"        (constraint hole_size (max 6.35mm))\n"
"        (condition \"A.Pad_Type == 'Through-hole'\"))\n"
"\n"
"\n"
"    # Задати оптимальний проміжок для конкретної диференційної пари\n"
"    (rule \"dp clock gap\"\n"
"        (constraint diff_pair_gap (opt \"0.8mm\"))\n"
"        (condition \"A.inDiffPair('/CLK')\"))\n"
"\n"
"    # Задати більший зазор навколо будь-якої диференційної пари\n"
"    (rule \"dp clearance\"\n"
"        (constraint clearance (min \"1.5mm\"))\n"
"        (condition \"A.inDiffPair('*') && !AB.isCoupledDiffPair()\"))\n"
"\n"
"\n"
"    # Не використовувати теплові бар'єри на контактних площадках "
"тепловідводу\n"
"    (rule heat_sink_pad\n"
"        (constraint zone_connection solid)\n"
"        (condition \"A.Fabrication_Property == 'Heatsink pad'\"))\n"
"\n"
"    # Вимагати, щоб усі чотири спиці теплового бар'єра з'єднувалися з "
"батьківською зоною\n"
"    (rule fully_spoked_pads\n"
"        (constraint min_resolved_spokes 4))\n"
"\n"
"    # Задати проміжок теплового бар'єра та ширину спиць для всіх зон\n"
"    (rule defined_relief\n"
"        (constraint thermal_relief_gap (min 10mil))\n"
"        (constraint thermal_spoke_width (min 12mil)))\n"
"\n"
"    # Перевизначити проміжок теплового бар'єра та ширину спиць для зон GND і "
"PWR\n"
"    (rule defined_relief_pwr\n"
"        (constraint thermal_relief_gap (min 10mil))\n"
"        (constraint thermal_spoke_width (min 12mil))\n"
"        (condition \"A.Name == 'zone_GND' || A.Name == 'zone_PWR'\"))\n"
"\n"
"    # Заборонити мідні заливки під областями встановлення конденсаторів\n"
"    (rule no_copper_under_caps\n"
"        (constraint physical_clearance (min 0mm))\n"
"        (condition \"A.Type == 'Zone' && B.Reference == 'C*'\"))\n"
"\n"
"\n"
"    # Запобігти стіканню припою з SMD-площадок\n"
"    (rule holes_in_pads\n"
"        (constraint physical_hole_clearance (min 0.2mm))\n"
"        (condition \"B.Pad_Type == 'SMD'\"))\n"
"\n"
"    # Заборонити перевизначення відступу паяльної маски\n"
"    (rule \"disallow solder mask margin overrides\"\n"
"        (constraint assertion \"A.Soldermask_Margin_Override == null\")\n"
"        (condition \"A.Type == 'Pad'\"))\n"
"\n"
"\n"
"    # Забезпечити механічний зазор між компонентами та краєм плати\n"
"    (rule front_mechanical_board_edge_clearance\n"
"        (layer \"F.Courtyard\")\n"
"        (constraint physical_clearance (min 3mm))\n"
"        (condition \"B.Layer == 'Edge.Cuts'\"))\n"
"\n"
"\n"
"    # Дозволити перетин шовкографії з краєм плати для роз'ємів\n"
"    (rule silk_board_edge_clearance\n"
"        (constraint silk_clearance)\n"
"        (severity ignore)\n"
"        (condition \"A.memberOfFootprint('J*') && B.Layer=='Edge.Cuts'\"))\n"
"\n"
"\n"
"    # Перевірити струмонесучу здатність\n"
"    (rule high-current\n"
"        (constraint track_width (min 1.0mm))\n"
"        (constraint connection_width (min 0.8mm))\n"
"        (condition \"A.hasNetclass('Power')\"))\n"
"\n"
"\n"
"    # Окремі обмеження розміру для свердла та фрези\n"
"    (rule \"Plated through-hole size\"\n"
"        (constraint hole_size (min 0.2mm) (max 6.35mm))\n"
"        (condition \"A.isPlated() && A.Hole_Size_X == A.Hole_Size_Y\"))\n"
"    (rule \"Plated slot size\"\n"
"        (constraint hole_size (min 0.5mm))\n"
"        (condition \"A.isPlated() && A.Hole_Size_X != A.Hole_Size_Y\"))\n"
"\n"
"\n"
"    # Дозволити порушення hole-to-hole між глухими та мікроперехідними "
"отворами,\n"
"    # якщо відомо, що виробник механічно свердлить глухі отвори -до- "
"лазерного\n"
"    # свердління мікроперехідних отворів.\n"
"    (rule hole_to_hole_uvia_exclusion\n"
"        (condition \"A.Via_Type == 'Blind' && B.Via_Type == 'Micro'\")\n"
"        (constraint hole_to_hole)\n"
"        (severity ignore))\n"
"\n"
"\n"
"    # Без розширення паяльної маски для перехідних отворів.\n"
"    (rule \"no mask expansion on vias\"\n"
"        (constraint solder_mask_expansion (opt 0mm))\n"
"        (condition \"A.type == via\"))\n"
"\n"
"\n"
"    # Прибрати паяльну пасту з посадкових місць DNP.\n"
"    (rule remove_solder_paste_from_DNP\n"
"        (constraint solder_paste_abs_margin (opt -50mm))\n"
"        (condition \"A.Do_not_Populate\"))\n"
"\n"
"\n"
"    # Дозволити перемички паяльної маски під вікнами маски захисного кільця\n"
"    (rule guard_ring_bridging\n"
"        (constraint bridged_mask)\n"
"        (condition \"A.intersectsArea('guard_ring')\")\n"
"        (severity ignore))\n"

