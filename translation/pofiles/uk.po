msgstr "недостатньо полів перехідного отвору"

#: pcbnew/pcb_io/autotrax/autotrax_parser.cpp:187
msgid "insufficient pad fields"
msgstr "недостатньо полів контактної площадки"

#: pcbnew/pcb_io/autotrax/autotrax_parser.cpp:219
