#version 450
layout(local_size_x_id = 0, local_size_y_id = 1, local_size_z = 1) in;
layout(set = 0, binding = 1, std430) readonly buffer Input { float values[]; };
layout(set = 0, binding = 2, std430) buffer Output { float partials[]; };
shared float scratch[gl_WorkGroupSize.x * gl_WorkGroupSize.y];
void main()
{
    uint local = gl_LocalInvocationIndex;
    scratch[local] = abs(values[gl_GlobalInvocationID.x]);
    barrier();

    for (uint stride = gl_WorkGroupSize.x * gl_WorkGroupSize.y / 2; stride > 0; stride >>= 1)
    {
        if (local < stride)
            scratch[local] = max(scratch[local], scratch[local + stride]);

        barrier();
    }

    if (local == 0)
        partials[gl_WorkGroupID.x] = scratch[0];
}
