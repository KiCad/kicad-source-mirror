#version 450
layout(local_size_x_id = 0, local_size_y_id = 1, local_size_z = 1) in;
layout(set = 0, binding = 1, std430) buffer Output { uint sizes[]; };
void main()
{
    if (gl_LocalInvocationIndex == 0)
    {
        sizes[0] = gl_WorkGroupSize.x;
        sizes[1] = gl_WorkGroupSize.y;
    }
}
