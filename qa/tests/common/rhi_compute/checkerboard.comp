#version 450
layout(local_size_x_id = 0, local_size_y_id = 1, local_size_z = 1) in;
layout(constant_id = 2) const uint RB = 0;
layout(set = 0, binding = 1, std430) buffer Output { uint cells[]; };
layout(push_constant) uniform Params { uint width; uint height; } p;
void main()
{
    uvec2 xy = gl_GlobalInvocationID.xy;

    if (xy.x < p.width && xy.y < p.height && ((xy.x + xy.y) & 1u) == RB)
        cells[xy.y * p.width + xy.x] = 17u + RB;
}
