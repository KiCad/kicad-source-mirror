#version 450
layout(local_size_x_id = 0, local_size_y_id = 1, local_size_z = 1) in;
layout(constant_id = 2) const uint PASS = 2;
layout(set = 0, binding = 1, std430) buffer Data { uint cells[]; };
layout(push_constant) uniform Params { uint width; uint height; } p;
void main()
{
    uvec2 xy = gl_GlobalInvocationID.xy;

    if (xy.x >= p.width || xy.y >= p.height)
        return;

    uint i = xy.y * p.width + xy.x;

    if (PASS == 2)
        cells[i] = (xy.x + 3u * xy.y) % 11u;
    else if (((xy.x + xy.y) & 1u) == PASS)
    {
        uint neighbour = xy.x == 0 ? i + 1u : i - 1u;
        cells[i] += 1u + (cells[neighbour] % 3u);
    }
}
