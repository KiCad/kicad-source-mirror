(version 1)
# Enforce same length for PCIe lanes
(rule "PCIe"
  (condition "A.NetClass == 'PCIe'")
  (constraint skew (min -2ps) (opt 0ps) (max 2ps)(within_diff_pairs))
  # (constraint length (min 450ps) (opt 500ps) (max 550ps))
  (severity error))
(rule "PCIeCLK"
  (condition "A.NetClass == 'PCIeCLK'")
  (constraint skew (min -2ps) (opt 0ps) (max 2ps)(within_diff_pairs))
  # (constraint length (min 450ps) (opt 500ps) (max 550ps))
  (severity error))
