# Build step of kicad_add_shaders() that embeds one shader's SPIR-V, and MSL when MSL_FILE is set, in a C++ header.
# Expects SHADER_NAME, SHADER_STAGE, SPV_FILE and HEADER_FILE to be defined.

string( TOUPPER "${SHADER_NAME}" SHADER_NAME_UPPER )
string( TOUPPER "${SHADER_STAGE}" SHADER_STAGE_UPPER )
set( GUARD_NAME "RHI_SHADER_${SHADER_NAME_UPPER}_${SHADER_STAGE_UPPER}_H" )
set( ARRAY_PREFIX "k_${SHADER_NAME}_${SHADER_STAGE}" )

file( READ "${SPV_FILE}" SPV_HEX HEX )
string( LENGTH "${SPV_HEX}" SPV_HEX_LEN )
math( EXPR SPV_BYTE_COUNT "${SPV_HEX_LEN} / 2" )

string( REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1, " SPV_ARRAY "${SPV_HEX}" )
string( REGEX REPLACE ", $" "" SPV_ARRAY "${SPV_ARRAY}" )

set( HEADER_CONTENT
"// Auto-generated by GenerateShaderHeader.cmake -- do not edit
#pragma once

#include <rhi/rhi_shader.h>

// SPIR-V bytecode (${SPV_BYTE_COUNT} bytes)
alignas( 4 ) static const uint8_t ${ARRAY_PREFIX}_spirv[] = {
    ${SPV_ARRAY}
};
" )

if( MSL_FILE )
    # MSVC rejects string literals over 16380 bytes (C2026), so the MSL text is embedded as a NUL terminated
    # byte array.
    file( READ "${MSL_FILE}" MSL_HEX HEX )
    string( REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1, " MSL_ARRAY "${MSL_HEX}" )

    string( APPEND HEADER_CONTENT "
// Metal Shading Language source, NUL terminated
static const char ${ARRAY_PREFIX}_msl[] = {
    0x0a, ${MSL_ARRAY}0x00
};

static const RHI_SHADER_BLOB ${ARRAY_PREFIX} = { ${ARRAY_PREFIX}_spirv, sizeof( ${ARRAY_PREFIX}_spirv ),
                                                 ${ARRAY_PREFIX}_msl, sizeof( ${ARRAY_PREFIX}_msl ) - 1 };
" )
else()
    string( APPEND HEADER_CONTENT "
static const RHI_SHADER_BLOB ${ARRAY_PREFIX} = { ${ARRAY_PREFIX}_spirv, sizeof( ${ARRAY_PREFIX}_spirv ) };
" )
endif()

file( WRITE "${HEADER_FILE}" "${HEADER_CONTENT}" )

message( STATUS "Generated shader header: ${HEADER_FILE} (${SPV_BYTE_COUNT} bytes SPIR-V)" )
